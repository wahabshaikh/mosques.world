# Public build-time values. Copy to `.env.local` (git-ignored) for `pnpm dev` / `pnpm build`.
# vinext inlines NEXT_PUBLIC_* into the browser bundle. Other secrets stay in `.dev.vars`.
#
# Browser error reporting. Same DSN as the SENTRY_DSN Worker secret. Unset disables the browser SDK.
# Production and Preview: set this as a Workers Builds build variable, not a Wrangler secret.
NEXT_PUBLIC_SENTRY_DSN=
